diff --git a/arch/arm64/boot/dts/renesas/r9a07g076-multi-os.dtsi b/arch/arm64/boot/dts/renesas/r9a07g076-multi-os.dtsi
new file mode 100644
index 0000000000000..cf723368e9de8
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/r9a07g076-multi-os.dtsi
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Device Tree Source for the RZ/T2N SoC
+ *
+ * Copyright (C) 2024 Renesas Electronics Corp.
+ */
+
+ / {
+	vring-ctl0@207000000 {
+		compatible = "vring_uio";
+		reg = <0x02 0x07000000 0x0 0x100000>;
+		no-map;
+	};
+
+	vring-ctl1@207100000 {
+		compatible = "vring_uio";
+		reg = <0x02 0x07100000 0x0 0x100000>;
+		no-map;
+	};
+
+	vring-shm0@207200000 {
+		compatible = "shm_uio";
+		reg = <0x02 0x07200000 0x0 0x300000>;
+		no-map;
+	};
+
+	vring-shm1@207500000 {
+		compatible = "shm_uio";
+		reg = <0x02 0x07500000 0x0 0x300000>;
+		no-map;
+	};
+
+	rsctbl@206000000 {
+		compatible = "shm_uio";
+		reg = <0x02 0x06000000 0x0 0x1000>;
+		no-map;
+	};
+
+	intercpu-shm@206001000 {
+		compatible = "shm_uio";
+		reg = <0x02 0x06001000 0x0 0x1000>;
+		no-map;
+	};
+
+	mbox-uio@802A0000 {
+		compatible = "mbox_uio";
+		reg = <0x0 0x802A0000 0x0 0x1000>,
+			<0x0 0x812A0000 0x0 0x1000>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 1 IRQ_TYPE_EDGE_RISING>;
+		status = "okay";
+	};
+};
