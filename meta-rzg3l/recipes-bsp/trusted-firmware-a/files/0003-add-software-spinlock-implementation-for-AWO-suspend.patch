index 8bbc5342d..9e176282a 100644
--- a/plat/renesas/rz/soc/g3l/platform.mk
+++ b/plat/renesas/rz/soc/g3l/platform.mk
@@ -23,6 +23,7 @@ PLAT_BL_COMMON_SOURCES	+=	plat/renesas/rz/soc/g3l/drivers/riic.c					\
