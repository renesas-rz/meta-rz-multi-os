+++ b/plat/renesas/rz/soc/g3l/plat_pm.c
@@ -24,6 +24,7 @@
 #include <pfc.h>
 #include <rz_console.h>
 #include <core_ctrl.h>
+#include <lib/spinlock.h>
 
 #define LO_REG							(0U)
 #define HI_REG							(1U)
@@ -135,7 +136,7 @@ static void rz_pwr_domain_suspend(const psci_power_state_t *target_state)
 	plat_gic_save();
 
 	/* Enable the transition request interrupt to the Cortex-A55 Sleep Mode */
-	mmio_write_32(SYS_LP_CTL6, 0x00000100);
+	mmio_write_32(SYS_LP_CTL6, mmio_read_32(SYS_LP_CTL6) | 0x00000100);
 }
 
 static void rz_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
